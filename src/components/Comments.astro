<div class="comments">
    <h2>评论区</h2>

    <noscript>
        <p>
            敝网志的评论功能由<a href="https://giscus.app/">giscus</a>
            提供支持，需要加载JavaScript脚本。
        </p>
        <p>你的浏览器不支持或未启用JavaScript，评论区将无法加载。</p>
    </noscript>

    <div id="giscus-container" hidden>
        <div id="comments-hint">
            <p>
                敝网志的评论功能由<a href="https://giscus.app/">giscus</a>
                提供支持，需要加载JavaScript脚本；为避免不必要的流量消耗，需手动点击“加载评论”。
            </p>
            <p>发表评论需要阁下使用GitHub登录。</p>
        </div>
        <button id="load-comments" type="button">
            加载评论
        </button>
    </div>

    <script is:inline>
        const button = document.getElementById("load-comments");
        const hint = document.getElementById("comments-hint");
        const container = document.getElementById("giscus-container");

        container.hidden = false;

        button?.addEventListener("click", () => {
            button.disabled = true;
            button.textContent = "加载中……";

            const script = document.createElement("script");
            script.src = "https://giscus.app/client.js";
            script.async = true;
            script.crossOrigin = "anonymous";

            script.setAttribute("data-repo", "VentusUta/ventusuta.com");
            script.setAttribute("data-repo-id", "R_kgDOUpPi6g");
            script.setAttribute("data-category", "Comments");
            script.setAttribute("data-category-id", "DIC_kwDOUpPi6s4DKfoN");
            script.setAttribute("data-mapping", "pathname");
            script.setAttribute("data-strict", "1");
            script.setAttribute("data-reactions-enabled", "0");
            script.setAttribute("data-emit-metadata", "0");
            script.setAttribute("data-input-position", "top");
            script.setAttribute("data-theme", "light");
            script.setAttribute("data-lang", "zh-CN");

            script.onload = () => {
                hint?.remove();
                button.remove();
            };

            container.appendChild(script);
        });
    </script>
</div>

<style>
    .comments {
        border-top: 1px solid #aaa;
        margin-top: 1.5em;
    }

    #giscus-container p {
        margin-top: 0;
    }

    #load-comments {
        display: block;
        width: 100%;
        background: none;
        border: 1px solid;
        padding: 0.5em 0.75em;
        font: inherit;
        text-align: center;
    }

    #load-comments:hover,
    #load-comments:focus-visible {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-position: under;
    }
</style>
