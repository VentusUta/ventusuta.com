---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const friends = (await getCollection("links")).sort((a, b) =>
	a.data.name.localeCompare(b.data.name, "zh-CN"),
);
---

<BaseLayout title="友情链接" description="Ventus Uta的朋友们">
	<h1 class="page-title">友情链接</h1>
	<p>我的信息：</p>
	<ul>
		<li>标题：Ventus Uta</li>
		<li>头像：https://avatars.githubusercontent.com/u/135337676?v=4</li>
		<li>链接：https://ventusuta.com/</li>
		<li>描述：8点、Classroom见</li>
		<li>RSS（只有网络日志）：https://ventusuta.com/rss.xml</li>
	</ul>
	<p>可以给我的邮箱发邮件来互联哦：ventusuta★gmail.com（将“★”换为“@”）。</p>
	<p>
		友情链接需要提供的信息：标题、头像URL（请勿提交SVG格式）、链接、描述、RSS链接（如果有）。
	</p>
	{
		friends.length === 0 ? (
			<p>还没有友链。</p>
		) : (
			<ul class="friend-list">
				{friends.map((friend) => (
					<li class="friend-card">
						{friend.data.icon ? (
							<img
								class="friend-icon"
								src={friend.data.icon}
								alt=""
								width="32"
								height="32"
							/>
						) : (
							<span class="friend-icon" aria-hidden="true">
								{friend.data.name.slice(0, 1)}
							</span>
						)}
						<div class="friend-body">
							<div class="friend-heading">
								<a
									href={friend.data.url}
									rel="noopener noreferrer"
								>
									{friend.data.name}
								</a>
								{friend.data.rss && (
									<a
										class="friend-rss"
										href={friend.data.rss}
										rel="noopener noreferrer"
									>
										RSS
									</a>
								)}
							</div>
							{friend.data.description && (
								<p>{friend.data.description}</p>
							)}
						</div>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>
