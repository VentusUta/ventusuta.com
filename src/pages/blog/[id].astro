---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { SITE_LANG } from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
	title={`${post.data.title}_网志`}
	description={post.data.description ?? undefined}
>
	<article lang={post.data.lang || undefined}>
		<header class="post-header">
			<h1>{post.data.title}</h1>
			<div class="meta" lang={SITE_LANG}>
				<p>
					<time datetime={post.data.pubDate.toISOString()}
						>{formatDate(post.data.pubDate)}</time
					>
					{
						post.data.updatedDate && (
							<>
								{"（"}
								更新于
								<time
									datetime={post.data.updatedDate.toISOString()}
								>
									{formatDate(post.data.updatedDate)}
								</time>
								{"）"}
							</>
						)
					}
				</p>
				{
					post.data.tags.length > 0 && (
						<div class="post-tags">
							<span class="tag-label">标签：</span>
							<ul class="tags">
								{post.data.tags.map((tag) => (
									<li>
										<a
											href={`/blog/tags/${encodeURIComponent(tag)}/`}
										>
											{tag}
										</a>
									</li>
								))}
							</ul>
						</div>
					)
				}
			</div>
		</header>
		<div class="prose">
			<Content />
		</div>
	</article>
</BaseLayout>
